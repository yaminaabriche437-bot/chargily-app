# --- Copie ce fichier en ".env" et remplis TES vraies valeurs ---
# ⚠️ Ne commite JAMAIS le fichier ".env" (ajoute-le à .gitignore)

# Clé secrète Chargily (obtenue depuis ton tableau de bord Chargily Pay)
CHARGILY_SECRET_KEY=colle_ta_nouvelle_cle_secrete_ici

# Clé publique Chargily (optionnelle, non sensible)
CHARGILY_PUBLIC_KEY=colle_ta_cle_publique_ici

# Passe à "true" uniquement quand tu es prêt à recevoir de vrais paiements
CHARGILY_LIVE_MODE=false

# URL publique de ton site une fois déployé (ex: https://monsite.com)
SITE_URL=http://localhost:3000

# Liens vers l'ebook
EBOOK_VIEW_LINK=https://drive.google.com/file/d/1ydIBwE2M-ViDNX3uTYLfO0wghwQvhWEh/view?usp=drive_link
EBOOK_DOWNLOAD_LINK=https://drive.google.com/uc?export=download&id=1ydIBwE2M-ViDNX3uTYLfO0wghwQvhWEh

# Email du propriétaire qui reçoit les notifications de vente
OWNER_EMAIL=freelandz123@gmail.com

# --- Configuration SMTP pour l'envoi des emails automatiques ---
# Exemple avec Gmail (nécessite un "mot de passe d'application") :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton_email@gmail.com
SMTP_PASS=ton_mot_de_passe_application

PORT=3000
